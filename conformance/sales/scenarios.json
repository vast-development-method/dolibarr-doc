{
  "release": "24.0.3",
  "sourceCommit": "5c6c7ff6a5112413b1c27221c8d11750afad56f8",
  "cases": [
    {
      "id": "ALLOC-EXACT",
      "rule": "allocation",
      "description": "Draft four counts. Cancelled and unrelated rows do not consume this line.",
      "input": {
        "ceilingEnabled": true,
        "orderLine": 101,
        "orderedQty": "10",
        "requestedQty": "6",
        "allocations": [
          {"rowId": 1, "orderLine": 101, "shipmentStatus": 0, "qty": "4"},
          {"rowId": 2, "orderLine": 101, "shipmentStatus": -1, "qty": "3"},
          {"rowId": 3, "orderLine": 102, "shipmentStatus": 2, "qty": "8"}
        ]
      },
      "expected": {
        "remainingBeforeRequest": "6",
        "permittedByCeiling": true
      }
    },
    {
      "id": "ALLOC-EXCESS",
      "rule": "allocation",
      "description": "A request exceeding the remaining six is refused.",
      "input": {
        "ceilingEnabled": true,
        "orderLine": 101,
        "orderedQty": "10",
        "requestedQty": "7",
        "allocations": [
          {"rowId": 1, "orderLine": 101, "shipmentStatus": 0, "qty": "4"},
          {"rowId": 2, "orderLine": 101, "shipmentStatus": -1, "qty": "3"},
          {"rowId": 3, "orderLine": 102, "shipmentStatus": 2, "qty": "8"}
        ]
      },
      "expected": {
        "remainingBeforeRequest": "6",
        "permittedByCeiling": false
      }
    },
    {
      "id": "ALLOC-EDIT",
      "rule": "allocation",
      "description": "Replacing the existing draft row excludes its old four from the sum.",
      "input": {
        "ceilingEnabled": true,
        "orderLine": 101,
        "orderedQty": "10",
        "requestedQty": "10",
        "allocations": [
          {"rowId": 1, "orderLine": 101, "shipmentStatus": 0, "qty": "4"},
          {"rowId": 2, "orderLine": 101, "shipmentStatus": -1, "qty": "3"},
          {"rowId": 3, "orderLine": 102, "shipmentStatus": 2, "qty": "8"}
        ],
        "editingRow": 1
      },
      "expected": {
        "remainingBeforeRequest": "10",
        "permittedByCeiling": true
      }
    },
    {
      "id": "ALLOC-DISABLED",
      "rule": "allocation",
      "description": "The optional ceiling is disabled even though the request exceeds the remaining quantity.",
      "input": {
        "ceilingEnabled": false,
        "orderLine": 101,
        "orderedQty": "10",
        "requestedQty": "7",
        "allocations": [
          {"rowId": 1, "orderLine": 101, "shipmentStatus": 0, "qty": "4"},
          {"rowId": 2, "orderLine": 101, "shipmentStatus": -1, "qty": "3"},
          {"rowId": 3, "orderLine": 102, "shipmentStatus": 2, "qty": "8"}
        ]
      },
      "expected": {
        "remainingBeforeRequest": "6",
        "permittedByCeiling": true
      }
    },
    {
      "id": "CLOSE-MATCH",
      "rule": "completion",
      "description": "Separate line allocations agree with both lines and their shared product total.",
      "input": {
        "event": "close",
        "workflowEvents": [
          "close"
        ],
        "stockSupportsServices": false,
        "orderLines": [
          {"id": 101, "product": "BOLT", "type": "goods", "qty": "4"},
          {"id": 102, "product": "BOLT", "type": "goods", "qty": "6"}
        ],
        "shipments": [
          {"orderLine": 101, "product": "BOLT", "status": 2, "qty": "4"},
          {"orderLine": 102, "product": "BOLT", "status": 2, "qty": "6"}
        ]
      },
      "expected": {
        "coreRequestsClosure": true,
        "workflowRequestsClosure": true
      }
    },
    {
      "id": "CLOSE-DISTRIBUTION",
      "rule": "completion",
      "description": "Same SKU, two order lines. Five on each meets the SKU total but leaves one source line short and the other long. The ceiling was disabled when the data was entered.",
      "input": {
        "event": "close",
        "workflowEvents": [
          "close"
        ],
        "stockSupportsServices": false,
        "orderLines": [
          {"id": 101, "product": "BOLT", "type": "goods", "qty": "4"},
          {"id": 102, "product": "BOLT", "type": "goods", "qty": "6"}
        ],
        "shipments": [
          {"orderLine": 101, "product": "BOLT", "status": 2, "qty": "5"},
          {"orderLine": 102, "product": "BOLT", "status": 2, "qty": "5"}
        ]
      },
      "expected": {
        "coreRequestsClosure": false,
        "workflowRequestsClosure": true
      }
    },
