      "expected": false
    },
    {
      "id": "DIRECT-MULTIPLE",
      "rule": "directBilling",
      "description": "One invoice can match more than one eligible order. Cancelled orders are omitted from the amount sum.",
      "input": {
        "enabled": true,
        "allowDifferentAmounts": false,
        "totalPrecision": 2,
        "invoiceNet": "450.00",
        "linkedOrders": [
          {"state": "validated", "net": "180.00"},
          {"state": "delivered", "net": "270.00"},
          {"state": "cancelled", "net": "10.00"}
        ]
      },
      "expected": true
    },
    {
      "id": "DIRECT-MISMATCH",
      "rule": "directBilling",
      "description": "Without the override, an invoice of 400 cannot satisfy the aggregate order-net gate of 450.",
      "input": {
        "enabled": true,
        "allowDifferentAmounts": false,
        "totalPrecision": 2,
        "invoiceNet": "400.00",
        "linkedOrders": [
          {"state": "validated", "net": "180.00"},
          {"state": "delivered", "net": "270.00"},
          {"state": "cancelled", "net": "10.00"}
        ]
      },
      "expected": false
    },
    {
      "id": "DIRECT-OVERRIDE",
      "rule": "directBilling",
      "description": "The unequal-amount override bypasses the direct total comparison.",
      "input": {
        "enabled": true,
        "allowDifferentAmounts": true,
        "totalPrecision": 2,
        "invoiceNet": "400.00",
        "linkedOrders": [
          {"state": "validated", "net": "180.00"},
          {"state": "delivered", "net": "270.00"},
          {"state": "cancelled", "net": "10.00"}
        ]
      },
      "expected": true
