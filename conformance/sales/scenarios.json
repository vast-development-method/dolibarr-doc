    {
      "id": "BILL-FIRST",
      "rule": "cumulativeBilling",
      "description": "First partial invoice of 180 is insufficient.",
      "input": {
        "enabled": true,
        "sourceOrderCount": 1,
        "validatingInvoice": 31,
        "orderNet": "450.00",
        "totalPrecision": 2,
        "linkedInvoices": [
          {"id": 31, "state": "validated", "net": "180.00"}
        ]
      },
      "expected": false
    },
    {
      "id": "BILL-SECOND",
      "rule": "cumulativeBilling",
      "description": "The currently validating invoice is counted even if its fetched state still says draft.",
      "input": {
        "enabled": true,
        "sourceOrderCount": 1,
        "validatingInvoice": 32,
        "orderNet": "450.00",
        "totalPrecision": 2,
        "linkedInvoices": [
          {"id": 31, "state": "closed", "net": "180.00"},
          {"id": 32, "state": "draft", "net": "270.00"}
        ]
      },
      "expected": true
    },
    {
      "id": "BILL-OTHER-DRAFT",
      "rule": "cumulativeBilling",
      "description": "Another draft invoice blocks classification even when its net is zero.",
      "input": {
        "enabled": true,
        "sourceOrderCount": 1,
        "validatingInvoice": 32,
        "orderNet": "450.00",
        "totalPrecision": 2,
        "linkedInvoices": [
          {"id": 31, "state": "closed", "net": "180.00"},
          {"id": 32, "state": "draft", "net": "270.00"},
          {"id": 33, "state": "draft", "net": "0.00"}
        ]
      },
      "expected": false
    },
    {
      "id": "BILL-ROUND-ON-SUM",
      "rule": "cumulativeBilling",
      "description": "Round the sum once. At precision two, 180.004 + 270.004 = 450.008 rounds to 450.01.",
      "input": {
        "enabled": true,
        "sourceOrderCount": 1,
        "validatingInvoice": 32,
        "orderNet": "450.01",
        "totalPrecision": 2,
        "linkedInvoices": [
          {"id": 31, "state": "closed", "net": "180.004"},
          {"id": 32, "state": "draft", "net": "270.004"}
        ]
      },
      "expected": true
    },
    {
      "id": "BILL-HALF",
      "rule": "cumulativeBilling",
      "description": "An amount halfway between cents rounds away from zero.",
      "input": {
        "enabled": true,
        "sourceOrderCount": 1,
        "validatingInvoice": 32,
        "orderNet": "450.00",
        "totalPrecision": 2,
        "linkedInvoices": [
          {"id": 32, "state": "validated", "net": "450.005"}
        ]
      },
      "expected": false
    },
    {
      "id": "BILL-MULTIPLE-SOURCES",
      "rule": "cumulativeBilling",
      "description": "The cumulative workflow only classifies an order if the triggering invoice has exactly one source order.",
      "input": {
        "enabled": true,
        "sourceOrderCount": 2,
        "validatingInvoice": 32,
        "orderNet": "450.00",
        "totalPrecision": 2,
        "linkedInvoices": [
          {"id": 32, "state": "validated", "net": "450.00"}
        ]
      },
      "expected": false
    },
    {
      "id": "BILL-DISABLED",
      "rule": "cumulativeBilling",
      "description": "Matching invoices do not trigger classification if the workflow option is off.",
