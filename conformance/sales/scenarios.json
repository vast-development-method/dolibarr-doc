        "enabled": false,
        "sourceOrderCount": 1,
        "validatingInvoice": 32,
        "orderNet": "450.00",
        "totalPrecision": 2,
        "linkedInvoices": [
          {"id": 32, "state": "validated", "net": "450.00"}
        ]
