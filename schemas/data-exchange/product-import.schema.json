{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parsed catalogue import keyed by product reference",
  "description": "Language-neutral five-field projection of the stable products import dataset. The wizard maps upload columns into this shape. Database uniqueness, matches and access are checked by the import service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "phase", "matchBy", "rows"],
  "properties": {
    "dataset": {"const": "products"},
    "phase": {"enum": ["simulate", "execute"]},
    "matchBy": {"const": "reference"},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reference", "label", "kind", "forSale", "forPurchase"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["product", "service"]},
          "forSale": {"type": "boolean"},
          "forPurchase": {"type": "boolean"}
        }
      }
    }
  }
}
