{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worked single-product trade cycle with balance checkpoints",
  "description": "Conformance fixture with an empty starting position, two-decimal currency, receipt/dispatch stock posting and tax-exclusive unit prices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "quantity",
              "netUnitPrice"
            ],
            "properties": {
              "operation": {
                "const": "supplier-order"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "netUnitPrice": {
                "$ref": "#/$defs/money"
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "quantity"
            ],
            "properties": {
              "operation": {
                "const": "receive"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "quantity",
              "netUnitPrice",
              "taxPercent"
            ],
            "properties": {
              "operation": {
                "const": "supplier-invoice"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "netUnitPrice": {
                "$ref": "#/$defs/money"
              },
              "taxPercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "quantity",
              "netUnitPrice"
            ],
            "properties": {
              "operation": {
                "const": "customer-order"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "netUnitPrice": {
                "$ref": "#/$defs/money"
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "quantity"
            ],
            "properties": {
              "operation": {
                "const": "ship"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "quantity",
              "netUnitPrice",
              "taxPercent"
            ],
            "properties": {
              "operation": {
                "const": "customer-invoice"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "netUnitPrice": {
                "$ref": "#/$defs/money"
              },
              "taxPercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "amount"
            ],
            "properties": {
              "operation": {
                "const": "collect"
              },
              "amount": {
                "$ref": "#/$defs/money"
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "expect",
              "amount"
            ],
            "properties": {
              "operation": {
                "const": "pay"
              },
              "amount": {
                "$ref": "#/$defs/money"
              },
              "expect": {
                "$ref": "#/$defs/balance"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "balance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "receivable",
        "payable",
        "bankChange"
      ],
      "properties": {
        "units": {
          "type": "integer",
          "minimum": 0
        },
        "receivable": {
          "$ref": "#/$defs/money"
        },
        "payable": {
          "$ref": "#/$defs/money"
        },
        "bankChange": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        }
      }
    }
  }
}
