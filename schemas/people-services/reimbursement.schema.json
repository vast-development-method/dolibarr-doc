{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Positive expense reimbursement",
  "description": "Normalized command envelope. Bank activation is resolved by the server. Amount is a positive decimal string in the report currency; prior payments and balance are service checks.",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "integer",
      "minimum": 1
    },
    "paymentDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "paymentMethodId": {
      "type": "integer",
      "minimum": 1
    },
    "amount": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:[.][0-9]+)?|0[.][0-9]*[1-9][0-9]*)$"
    },
    "bankEnabled": {
      "type": "boolean"
    },
    "bankAccountId": {
      "type": "integer",
      "minimum": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "reportId",
    "paymentDate",
    "paymentMethodId",
    "amount",
    "bankEnabled"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "bankEnabled": {
            "const": true
          }
        },
        "required": [
          "bankEnabled"
        ]
      },
      "then": {
        "required": [
          "bankAccountId"
        ]
      }
    }
  ]
}
