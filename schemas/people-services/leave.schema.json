{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leave request snapshot",
  "description": "Business projection of a card-flow request. Decision actor and time refer to the current approval, refusal or cancellation.",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "integer",
      "minimum": 1
    },
    "entityId": {
      "type": "integer",
      "minimum": 1
    },
    "employeeId": {
      "type": "integer",
      "minimum": 1
    },
    "leaveTypeId": {
      "type": "integer",
      "minimum": 1
    },
    "expectedApproverId": {
      "type": "integer",
      "minimum": 1
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "startHalf": {
      "enum": [
        "morning",
        "afternoon"
      ]
    },
    "endHalf": {
      "enum": [
        "morning",
        "afternoon"
      ]
    },
    "state": {
      "enum": [
        "draft",
        "pending",
        "approved",
        "refused",
        "canceled"
      ]
    },
    "decisionActorId": {
      "type": "integer",
      "minimum": 1
    },
    "decisionAt": {
      "type": "string",
      "format": "date-time",
      "minLength": 20
    },
    "refusalReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "requestId",
    "entityId",
    "employeeId",
    "leaveTypeId",
    "expectedApproverId",
    "startDate",
    "endDate",
    "startHalf",
    "endHalf",
    "state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "approved"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "decisionActorId",
          "decisionAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "refused"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "decisionActorId",
          "decisionAt",
          "refusalReason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "canceled"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "decisionActorId",
          "decisionAt"
        ]
      }
    }
  ]
}
