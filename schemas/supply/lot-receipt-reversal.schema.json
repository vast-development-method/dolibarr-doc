{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lot-level balances through receipt correction",
  "description": "Worked inventory reconciliation projection for one product and warehouse when receipts post on closure. Each stage records lot balances and the current product-wide unit cost. A declined reopen retains both the stored document state and stock positions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "productReference": {
      "type": "string",
      "minLength": 1
    },
    "warehouseReference": {
      "type": "string",
      "minLength": 1
    },
    "companyCurrency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "acquisitionUnitCost": {
      "$ref": "#/$defs/decimal"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "required": [
    "productReference",
    "warehouseReference",
    "companyCurrency",
    "acquisitionUnitCost",
    "stages"
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "opening",
            "close-receipt",
            "issue",
            "refuse-reopen",
            "receive-at-zero-price",
            "reopen-receipt",
            "reclose-receipt"
          ]
        },
        "stockChanged": {
          "type": "boolean"
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lot": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "$ref": "#/$defs/decimal"
              }
            },
            "required": [
              "lot",
              "quantity"
            ]
          }
        },
        "productAverageUnitCost": {
          "$ref": "#/$defs/decimal"
        }
      },
      "required": [
        "action",
        "stockChanged",
        "positions",
        "productAverageUnitCost"
      ]
    }
  }
}
