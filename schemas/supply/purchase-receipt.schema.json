{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order-linked receipt of positive stock quantities",
  "description": "Blueprint command projection for the warehouse-tracked delivery case. The service resolves each line's product and tracking policy from the purchase order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "splits"],
  "properties": {
    "orderId": { "$ref": "#/$defs/id" },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orderLineId", "warehouseId", "quantity", "unitCost", "tracking"],
        "properties": {
          "orderLineId": { "$ref": "#/$defs/id" },
          "warehouseId": { "$ref": "#/$defs/id" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unitCost": { "type": "number", "minimum": 0 },
          "tracking": { "enum": ["untracked", "lot"] },
          "batch": { "type": "string", "minLength": 1 },
          "sellBy": { "type": "string", "format": "date" },
          "eatBy": { "type": "string", "format": "date" }
        },
        "if": { "properties": { "tracking": { "const": "lot" } } },
        "then": { "required": ["batch"] },
        "else": { "not": { "anyOf": [
          { "required": ["batch"] }, { "required": ["sellBy"] }, { "required": ["eatBy"] }
        ] } }
      }
    }
  },
  "$defs": { "id": { "type": "integer", "minimum": 1 } }
}
