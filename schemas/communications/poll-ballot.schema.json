{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public poll ballot",
  "type": "object",
  "additionalProperties": false,
  "required": ["surveyKey", "voter", "responses"],
  "properties": {
    "surveyKey": {"type": "string", "minLength": 1},
    "voter": {"type": "string", "minLength": 1},
    "responses": {"type": "array", "minItems": 1, "items": {"type": "integer", "enum": [0, 1, 2]}}
  }
}
