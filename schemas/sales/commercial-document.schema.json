{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commercial proposal or customer order",
  "description": "Read projection for ordinary commercial lines. Decimal strings preserve precision. Header totals may also reflect other lines or tax policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "documentId",
    "entityId",
    "partyId",
    "reference",
    "state",
    "currency",
    "lines",
    "net",
    "vat",
    "gross"
  ],
  "properties": {
    "kind": {
      "enum": [
        "proposal",
        "order"
      ]
    },
    "documentId": {
      "type": "integer",
      "minimum": 1
    },
    "entityId": {
      "type": "integer",
      "minimum": 1
    },
    "partyId": {
      "type": "integer",
      "minimum": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string"
    },
    "billed": {
      "type": "boolean"
    },
    "sourceProposalId": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "net": {
      "$ref": "#/$defs/decimal"
    },
    "vat": {
      "$ref": "#/$defs/decimal"
    },
    "gross": {
      "$ref": "#/$defs/decimal"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "proposal"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "draft",
              "validated",
              "signed",
              "refused",
              "billed",
              "cancelled"
            ]
          },
          "billed": false
        },
        "description": "A proposal expresses billing in its state."
      },
      "else": {
        "required": [
          "billed"
        ],
        "properties": {
          "state": {
            "enum": [
              "draft",
              "validated",
              "shipment-in-process",
              "delivered",
              "cancelled"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "lineType",
        "description",
        "quantity",
        "unitNet",
        "discountPercent",
        "vatRate",
        "net",
        "vat",
        "gross"
      ],
      "properties": {
        "lineId": {
          "type": "integer",
          "minimum": 1
        },
        "lineType": {
          "enum": [
            "goods",
            "service"
          ]
        },
        "productId": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/decimal"
        },
        "unitNet": {
          "$ref": "#/$defs/decimal"
        },
        "discountPercent": {
          "$ref": "#/$defs/decimal"
        },
        "vatRate": {
          "$ref": "#/$defs/decimal"
        },
        "net": {
          "$ref": "#/$defs/decimal"
        },
        "vat": {
          "$ref": "#/$defs/decimal"
        },
        "gross": {
          "$ref": "#/$defs/decimal"
        }
      }
    }
  }
}
