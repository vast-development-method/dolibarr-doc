{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt Request",
  "type": "object",
  "properties": {
    "customerId": {
      "type": "integer",
      "minimum": 1
    },
    "paymentDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "paymentMode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "isCheque": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "isCheque"
      ],
      "additionalProperties": false
    },
    "bankEnabled": {
      "type": "boolean"
    },
    "bankAccountId": {
      "type": "integer",
      "minimum": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "enum": [
        "company",
        "invoice"
      ]
    },
    "allocations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "const": "remain"
          },
          {
            "$ref": "#/$defs/positive"
          }
        ]
      }
    },
    "autoClose": {
      "type": "boolean"
    },
    "acceptOverpayment": {
      "type": "boolean"
    },
    "externalRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "customerId",
    "paymentDate",
    "paymentMode",
    "bankEnabled",
    "basis",
    "allocations",
    "autoClose",
    "acceptOverpayment"
  ],
  "additionalProperties": false,
  "description": "Normalized customer receipt request. customerId, bankEnabled and paymentMode.isCheque must be resolved or checked against the target company configuration. Use the selected amount column for every invoice.",
  "$defs": {
    "positive": {
      "type": "string",
      "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.0*[1-9][0-9]*)$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "bankEnabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "bankAccountId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "bankEnabled": {
            "const": true
          },
          "paymentMode": {
            "properties": {
              "isCheque": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "issuer"
        ]
      }
    }
  ]
}
