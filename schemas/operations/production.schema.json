{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post manufacturing actuals against planned lines",
  "description": "Normalized partial posting contract for non-batch products. The server resolves the planned line, direction and stock policy against the specified order.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "integer",
      "minimum": 1
    },
    "movementCode": {
      "type": "string",
      "minLength": 1
    },
    "movementLabel": {
      "type": "string",
      "minLength": 1
    },
    "autoClose": {
      "type": "boolean"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/postingLine"
      }
    }
  },
  "required": [
    "orderId",
    "movementCode",
    "movementLabel",
    "autoClose",
    "lines"
  ],
  "$defs": {
    "postingLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planLineId": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "consume",
            "produce"
          ]
        },
        "quantity": {
          "type": "number",
          "not": {
            "const": 0
          },
          "description": "Signed quantity in the unit of the planned row. Negative values correct previous postings."
        },
        "stockEffect": {
          "enum": [
            "move",
            "none"
          ]
        },
        "warehouseId": {
          "type": "integer",
          "minimum": 1
        },
        "productionUnitCost": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "planLineId",
        "role",
        "quantity",
        "stockEffect"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "stockEffect": {
                "const": "move"
              }
            }
          },
          "then": {
            "required": [
              "warehouseId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "warehouseId"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "productionUnitCost"
            ]
          },
          "then": {
            "properties": {
              "stockEffect": {
                "const": "move"
              },
              "role": {
                "const": "produce"
              },
              "quantity": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
