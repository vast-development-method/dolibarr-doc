{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded project task time",
  "description": "Normalized record of a worker's booked time. A complete trace is present when this record was billed through the time conversion workflow.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entryId": {
      "type": "integer",
      "minimum": 1
    },
    "taskId": {
      "type": "integer",
      "minimum": 1
    },
    "workerId": {
      "type": "integer",
      "minimum": 1
    },
    "workDate": {
      "type": "string",
      "format": "date"
    },
    "startTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
      "description": "Local clock time if expressly recorded."
    },
    "durationSeconds": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "hourlyCost": {
      "type": [
        "number",
        "null"
      ],
      "description": "Captured worker rate in the reporting currency. Null means unknown."
    },
    "serviceId": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "billing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "invoiceId": {
              "type": "integer",
              "minimum": 1
            },
            "invoiceLineId": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "invoiceId",
            "invoiceLineId"
          ]
        }
      ]
    }
  },
  "required": [
    "entryId",
    "taskId",
    "workerId",
    "workDate",
    "durationSeconds",
    "hourlyCost",
    "billing"
  ]
}
